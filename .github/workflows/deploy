# ============================================================
# CI/CD - Déploiement automatique sur GitHub Pages
# ============================================================
# Ce workflow se déclenche à chaque push sur la branche main
# Il valide le code puis déploie automatiquement le site
# ============================================================

name: 🚀 Deploy to GitHub Pages

on:
  # Déploiement automatique à chaque push sur main
  push:
    branches: [main]

  # Permet de lancer manuellement depuis l'interface GitHub
  workflow_dispatch:

# Permissions requises pour déployer sur GitHub Pages
permissions:
  contents: read
  pages: write
  id-token: write

# Annule les déploiements en cours si un nouveau push arrive
concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
  # ============================================================
  # JOB 1 : VALIDATION (Lint & Tests)
  # ============================================================
  validate:
    name: ✅ Validate code
    runs-on: ubuntu-latest
    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4

      - name: 🔧 Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: 📦 Install validation tools
        run: |
          npm install -g html-validate
          npm install -g eslint

      - name: 🔍 Validate HTML files
        run: |
          echo "Validation des fichiers HTML..."
          html-validate --config .htmlvalidate.json index.html pages/*.html || echo "⚠️ Avertissements HTML détectés (non bloquant)"
        continue-on-error: true

      - name: 📝 Check JavaScript syntax
        run: |
          echo "Vérification de la syntaxe JavaScript..."
          for js_file in js/*.js; do
            node --check "$js_file" && echo "✓ $js_file"
          done

      - name: 🎨 Check CSS files exist
        run: |
          test -f css/style.css && echo "✓ CSS trouvé"

      - name: 📂 Check critical files
        run: |
          echo "Vérification des fichiers essentiels..."
          required_files=("index.html" "css/style.css" "css/admin.css" "js/data.js" "js/main.js" "js/checkout.js" "js/auth.js" "js/firebase-config.js" "js/books-service.js" "js/admin.js" "pages/livre.html" "pages/checkout.html" "pages/confirmation.html" "admin/login.html" "admin/dashboard.html" "admin/settings.html" "images/logo.svg" "images/favicon.svg")
          for file in "${required_files[@]}"; do
            if [ -f "$file" ]; then
              echo "✓ $file"
            else
              echo "✗ MANQUANT: $file"
              exit 1
            fi
          done

  # ============================================================
  # JOB 2 : BUILD (Préparation des fichiers)
  # ============================================================
  build:
    name: 🔨 Build site
    runs-on: ubuntu-latest
    needs: validate
    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4

      - name: 🛠️ Prepare build
        run: |
          echo "Préparation du build..."
          mkdir -p _build
          cp -r index.html css js pages images admin _build/
          touch _build/.nojekyll
          echo "Build: $(date -u +%Y-%m-%dT%H:%M:%SZ)" > _build/version.txt
          echo "Commit: ${{ github.sha }}" >> _build/version.txt
          ls -la _build/

      - name: 📦 Setup Pages
        uses: actions/configure-pages@v4

      - name: 📤 Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: '_build'

  # ============================================================
  # JOB 3 : DEPLOY (Déploiement sur GitHub Pages)
  # ============================================================
  deploy:
    name: 🌍 Deploy to Pages
    runs-on: ubuntu-latest
    needs: build
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: 🚀 Deploy
        id: deployment
        uses: actions/deploy-pages@v4

      - name: ✨ Deployment summary
        run: |
          echo "## 🎉 Déploiement réussi !" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "Votre site MAM++ est en ligne :" >> $GITHUB_STEP_SUMMARY
          echo "🔗 **${{ steps.deployment.outputs.page_url }}**" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "- 📅 Déployé le : $(date)" >> $GITHUB_STEP_SUMMARY
          echo "- 🔖 Commit : \`${{ github.sha }}\`" >> $GITHUB_STEP_SUMMARY
