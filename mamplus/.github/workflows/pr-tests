# ============================================================
# CI - Tests sur Pull Requests
# ============================================================
# Ce workflow vérifie automatiquement le code des PRs
# avant qu'elles puissent être fusionnées dans main
# ============================================================

name: 🧪 PR Tests

on:
  pull_request:
    branches: [main]

jobs:
  # ============================================================
  # JOB 1 : QUALITÉ DU CODE
  # ============================================================
  code-quality:
    name: 🔍 Code Quality
    runs-on: ubuntu-latest
    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4

      - name: 🔧 Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: 📝 JavaScript syntax check
        run: |
          echo "🔎 Vérification de la syntaxe JavaScript..."
          errors=0
          for js_file in js/*.js; do
            if ! node --check "$js_file" 2>/dev/null; then
              echo "❌ Erreur de syntaxe dans : $js_file"
              errors=$((errors + 1))
            else
              echo "✅ $js_file"
            fi
          done
          if [ $errors -gt 0 ]; then
            echo "⚠️  $errors fichier(s) avec erreurs de syntaxe"
            exit 1
          fi

      - name: 🎨 CSS basic validation
        run: |
          echo "🔎 Vérification basique CSS..."
          if [ -f css/style.css ]; then
            # Vérifier l'équilibre des accolades
            opens=$(grep -o '{' css/style.css | wc -l)
            closes=$(grep -o '}' css/style.css | wc -l)
            if [ "$opens" -eq "$closes" ]; then
              echo "✅ CSS bien formé ($opens accolades équilibrées)"
            else
              echo "❌ CSS mal formé : $opens ouvrantes vs $closes fermantes"
              exit 1
            fi
          fi

      - name: 📊 Check file sizes
        run: |
          echo "📦 Tailles des fichiers :"
          du -sh index.html css/ js/ pages/ images/ 2>/dev/null || true
          # Avertir si des fichiers sont trop gros
          find . -type f -size +500k -not -path './.git/*' -not -path './node_modules/*' | while read f; do
            echo "⚠️  Fichier volumineux : $f ($(du -h "$f" | cut -f1))"
          done

  # ============================================================
  # JOB 2 : SÉCURITÉ
  # ============================================================
  security:
    name: 🔒 Security Check
    runs-on: ubuntu-latest
    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4

      - name: 🔍 Search for exposed secrets
        run: |
          echo "🔎 Recherche de secrets exposés..."
          # Patterns dangereux
          patterns=(
            "sk_live_"
            "sk_test_[a-zA-Z0-9]{20,}"
            "AKIA[0-9A-Z]{16}"
            "AIza[0-9A-Za-z_-]{35}"
            "ghp_[0-9A-Za-z]{36}"
          )
          found=0
          for pattern in "${patterns[@]}"; do
            if grep -r -E "$pattern" --include="*.js" --include="*.html" --include="*.json" . 2>/dev/null | grep -v "VOTRE_CLE"; then
              echo "❌ Possible secret trouvé : $pattern"
              found=$((found + 1))
            fi
          done
          if [ $found -gt 0 ]; then
            echo "⚠️  Vérifiez qu'aucune vraie clé secrète n'est exposée"
            exit 1
          else
            echo "✅ Aucun secret exposé détecté"
          fi

  # ============================================================
  # JOB 3 : APERÇU DU SITE
  # ============================================================
  preview:
    name: 👀 Build Preview
    runs-on: ubuntu-latest
    needs: [code-quality, security]
    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4

      - name: 🔨 Test build
        run: |
          mkdir -p _preview
          cp -r index.html css js pages images _preview/
          touch _preview/.nojekyll
          echo "✅ Build de prévisualisation réussi"
          echo "📂 Contenu du build :"
          ls -la _preview/

      - name: 💬 Add PR comment
        uses: actions/github-script@v7
        with:
          script: |
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: `## ✅ Tests passés !

              Cette pull request a passé avec succès tous les tests :
              - ✅ Syntaxe JavaScript valide
              - ✅ CSS bien formé
              - ✅ Aucun secret exposé
              - ✅ Build de prévisualisation OK

              🚀 Cette PR est prête à être fusionnée dans \`main\`. Une fois fusionnée, le déploiement sur GitHub Pages se fera automatiquement.
              `
            })
