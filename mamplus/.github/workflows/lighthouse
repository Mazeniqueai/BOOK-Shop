# ============================================================
# Monitoring & Lighthouse - Vérifications périodiques
# ============================================================
# Lance des audits de performance et accessibilité
# - Tous les lundis à 6h UTC (ou manuellement)
# ============================================================

name: 📊 Lighthouse Audit

on:
  # Tous les lundis à 6h UTC
  schedule:
    - cron: '0 6 * * 1'

  # Lancement manuel depuis l'interface GitHub
  workflow_dispatch:

  # Après chaque déploiement
  workflow_run:
    workflows: ["🚀 Deploy to GitHub Pages"]
    types: [completed]

jobs:
  lighthouse:
    name: 🚦 Lighthouse Audit
    runs-on: ubuntu-latest
    if: ${{ github.event.workflow_run.conclusion == 'success' || github.event_name != 'workflow_run' }}
    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@v4

      - name: 🔧 Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: 🌐 Get Pages URL
        id: pages
        run: |
          # Détermine automatiquement l'URL GitHub Pages du dépôt
          REPO_NAME="${GITHUB_REPOSITORY##*/}"
          OWNER="${GITHUB_REPOSITORY_OWNER}"
          PAGES_URL="https://${OWNER}.github.io/${REPO_NAME}/"
          echo "url=${PAGES_URL}" >> $GITHUB_OUTPUT
          echo "🔗 URL à auditer : ${PAGES_URL}"

      - name: 🚦 Run Lighthouse
        uses: treosh/lighthouse-ci-action@v11
        with:
          urls: |
            ${{ steps.pages.outputs.url }}
          uploadArtifacts: true
          temporaryPublicStorage: true
        continue-on-error: true

      - name: 📊 Audit summary
        run: |
          echo "## 📊 Rapport Lighthouse" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "Audit effectué sur : **${{ steps.pages.outputs.url }}**" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "📅 Date : $(date)" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "Consultez les artifacts pour le rapport détaillé (performance, accessibilité, SEO, bonnes pratiques)." >> $GITHUB_STEP_SUMMARY
